// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String               @id @default(uuid())
  email         String               @unique
  passwordHash  String?
  name          String?
  metaUserId    String?              @unique
  authProvider  String?
  avatarUrl     String?
  totpSecret    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  organizations OrganizationMember[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model OauthState {
  id        String   @id @default(uuid())
  state     String   @unique
  provider  String
  intent    String
  userId    String?
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Organization {
  id                String               @id @default(uuid())
  name              String
  slug              String               @unique
  planId            String?
  timezone          String               @default("Asia/Kolkata")
  parentId          String?
  parent            Organization?        @relation("OrgTree", fields: [parentId], references: [id])
  children          Organization[]       @relation("OrgTree")
  brandPersona      Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  members           OrganizationMember[]
  channels          Channel[]
  products          Product[]
  postMappings      PostMapping[]
  interactions      InteractionLog[]
  rules             AutomationRule[]
  contacts          Contact[]
  templates         WhatsAppTemplate[]
  campaigns         BroadcastCampaign[]
  shopifyStores     ShopifyStore[]
  orders            EcommerceOrder[]
  abandonedCarts    AbandonedCart[]
  wallet            Wallet?
  connections       MetaConnection[]
  conversations     Conversation[]
  webhookEvents     WebhookEvent[]
  storySettings     StorySettings?
  storyBatches      StoryBatch[]
  businessProfile   BusinessProfile?
  offerings         Offering[]
  postOfferingLinks PostOfferingLink[]
  leads             Lead[]
  postTagRuns       PostTagRun[]
  pageProfiles      PageProfile[]
  socialPosts       SocialPost[]
}

model OrganizationMember {
  id        String       @id @default(uuid())
  role      String       @default("OWNER")
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
}

model Channel {
  id                   String          @id @default(uuid())
  orgId                String
  org                  Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  connectionId         String?
  connection           MetaConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  platform             String
  channelIdentifier    String
  name                 String
  handle               String?
  avatarUrl            String?
  accessTokenEncrypted String
  keyVersion           Int             @default(1)
  permissions          String[]        @default([])
  subscribedFields     String[]        @default([])
  graphVersion         String          @default("v24.0")
  tokenExpiresAt       DateTime?
  dataAccessExpiresAt  DateTime?
  status               String          @default("ACTIVE")
  lastError            Json?
  lastHealthCheckAt    DateTime?
  lastInboundAt        DateTime?
  linkedChannelId      String?
  metadata             Json?
  isActive             Boolean         @default(true)
  conversations        Conversation[]
  pageProfile          PageProfile?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([platform, channelIdentifier])
  @@index([orgId, platform])
  @@index([status])
}

model MetaConnection {
  id                  String       @id @default(uuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider            String
  metaUserId          String?
  businessId          String?
  userTokenEncrypted  String
  keyVersion          Int          @default(1)
  grantedScopes       String[]     @default([])
  tokenExpiresAt      DateTime?
  dataAccessExpiresAt DateTime?
  status              String       @default("ACTIVE")
  lastCheckedAt       DateTime?
  channels            Channel[]
  createdAt           DateTime     @default(now())

  @@unique([orgId, provider, metaUserId])
}

model InboxContact {
  id             String         @id @default(uuid())
  orgId          String
  platform       String
  platformUserId String
  name           String?
  username       String?
  personId       String?
  phone          String?
  email          String?
  locale         String?
  tags           String[]       @default([])
  attributes     Json?
  conversations  Conversation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([orgId, platform, platformUserId])
  @@index([orgId, phone])
}

model Conversation {
  id              String         @id @default(uuid())
  orgId           String
  org             Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelId       String
  channel         Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contactId       String
  contact         InboxContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  windowExpiresAt DateTime?
  status          String         @default("OPEN")
  assignedTo      String?
  aiEnabled       Boolean        @default(true)
  unreadCount     Int            @default(0)
  messages        InboxMessage[]
  // What the AI has learned so far in this chat (date, city, guests, chosen
  // offering) so it never asks the same question twice.
  goalState       Json?
  leads           Lead[]
  updatedAt       DateTime       @updatedAt

  @@unique([channelId, contactId])
  @@index([orgId, status, lastInboundAt])
}

model InboxMessage {
  id                String       @id @default(uuid())
  orgId             String
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  platformMessageId String?
  direction         String
  type              String       @default("TEXT")
  body              String?
  payload           Json?
  status            String       @default("SENT")
  sentBy            String       @default("AUTOMATION")
  createdAt         DateTime     @default(now())

  @@unique([orgId, platformMessageId])
  @@index([conversationId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(uuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  object      String
  channelId   String?
  signatureOk Boolean
  payload     Json
  processedAt DateTime?
  error       Json?
  receivedAt  DateTime      @default(now())

  @@index([object, receivedAt])
}

model DataDeletionRequest {
  id               String    @id @default(uuid())
  confirmationCode String    @unique
  metaUserId       String?
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
}

model AutomationRule {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  triggerType String
  keywords    String[]     @default([])
  actions     Json
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Product {
  id            String        @id @default(uuid())
  orgId         String
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sku           String
  title         String
  description   String?
  price         Float
  currency      String        @default("INR")
  inStock       Boolean       @default(true)
  stockQuantity Int           @default(10)
  sizes         String[]
  colors        String[]
  checkoutUrl   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  postMappings  PostMapping[]

  @@unique([orgId, sku])
}

model PostMapping {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  postId    String
  caption   String?
  productId String?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, postId])
}

model InteractionLog {
  id              String       @id @default(uuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelType     String
  eventType       String
  inboundMessage  String
  senderId        String
  publicReply     String?
  privateDm       String?
  intent          String?
  sentiment       String?
  requiresHuman   Boolean      @default(false)
  isResolved      Boolean      @default(false)
  externalEventId String?      @unique
  offeringIds     String[]     @default([])
  action          String?
  createdAt       DateTime     @default(now())
}

model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  eventId   String   @unique
  source    String
  createdAt DateTime @default(now())
}

model WhatsAppMessageStatus {
  id            String    @id @default(uuid())
  orgId         String?
  phoneNumberId String
  messageId     String
  recipientWaId String?
  status        String
  timestamp     DateTime?
  errorCode     String?
  errorTitle    String?
  rawPayload    Json?
  createdAt     DateTime  @default(now())

  @@index([messageId])
  @@index([status, createdAt])
}

model Contact {
  id               String       @id @default(uuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phone            String
  name             String?
  email            String?
  tags             String[]     @default([])
  optInStatus      Boolean      @default(true)
  customAttributes Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([orgId, phone])
}

model WhatsAppTemplate {
  id             String       @id @default(uuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  category       String       @default("MARKETING")
  language       String       @default("en_US")
  status         String       @default("APPROVED")
  components     Json
  metaTemplateId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([orgId, name, language])
}

model BroadcastCampaign {
  id              String       @id @default(uuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  templateName    String
  status          String       @default("DRAFT")
  scheduledAt     DateTime?
  totalRecipients Int          @default(0)
  sentCount       Int          @default(0)
  deliveredCount  Int          @default(0)
  readCount       Int          @default(0)
  failedCount     Int          @default(0)
  retryEnabled    Boolean      @default(true)
  retryCount      Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ShopifyStore {
  id                     String       @id @default(uuid())
  orgId                  String
  org                    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  shopDomain             String
  accessTokenEncrypted   String
  webhookSecret          String?
  codConfirmationEnabled Boolean      @default(true)
  abandonedCartEnabled   Boolean      @default(true)
  orderTrackingEnabled   Boolean      @default(true)
  // Approved WhatsApp template names. COD and cart messages usually go to people
  // outside the 24h service window, where Meta only accepts templates.
  codTemplateName        String?
  cartTemplateNames      String[]     @default([])
  templateLanguage       String       @default("en")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@unique([orgId, shopDomain])
}

model EcommerceOrder {
  id                 String       @id @default(uuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orderId            String
  customerPhone      String
  customerName       String?
  totalAmount        Float
  currency           String       @default("INR")
  paymentMethod      String       @default("COD")
  orderStatus        String       @default("OPEN")
  codStatus          String       @default("PENDING")
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  checkoutToken      String?
  itemsSummary       String?
  confirmationSentAt DateTime?
  confirmationError  String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([orgId, orderId])
  @@index([orgId, createdAt])
}

model AbandonedCart {
  id                 String       @id @default(uuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cartToken          String
  customerPhone      String
  customerName       String?
  cartValue          Float
  currency           String       @default("INR")
  checkoutUrl        String
  recoveryStatus     String       @default("PENDING")
  reminderStage      Int          @default(0)
  lastReminderSentAt DateTime?
  lastReminderError  String?
  itemsSummary       String?
  recoveredOrderId   String?
  recoveredAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([orgId, cartToken])
  @@index([orgId, createdAt])
}

model Wallet {
  id           String              @id @default(uuid())
  orgId        String              @unique
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  balance      Float               @default(0.0)
  currency     String              @default("INR")
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   @default("DEBIT")
  reason      String
  referenceId String?
  createdAt   DateTime @default(now())
}

// Daily Instagram story ideas: Gemini drafts four options each morning, the
// merchant picks one on WhatsApp, and the pick is published as an IG story.
model StorySettings {
  id                  String       @id @default(uuid())
  orgId               String       @unique
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  enabled             Boolean      @default(false)
  // Merchant's own WhatsApp number (digits with country code) that receives the ideas.
  whatsappNumber      String?
  // Channel.id of the Instagram account to publish to; the org's first active one when null.
  instagramChannelId  String?
  businessDescription String?
  // Semrush regional database, e.g. "in" or "us".
  keywordDatabase     String       @default("in")
  // Local time (org timezone, "HH:MM") the day's ideas are sent, and when the picked one goes live.
  sendTime            String       @default("09:00")
  postTime            String       @default("19:00")
  optionCount         Int          @default(5)
  // IG_STORY | IG_FEED | IG_REEL | FB_FEED
  destinations        String[]     @default(["IG_STORY"])
  // Channel.id of the Facebook Page for FB_FEED; the org's first active one when null.
  facebookChannelId   String?
  // Seller's own seed terms for trend research, on top of the business profile.
  nicheKeywords       String[]     @default([])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model StoryBatch {
  id               String        @id @default(uuid())
  orgId            String
  org              Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // Calendar day in the org's timezone (YYYY-MM-DD). One DAILY batch per org
  // per day; OWN batches (the seller's own photos) can be any number.
  forDate          String
  // DAILY | OWN
  kind             String        @default("DAILY")
  status           String        @default("GENERATING")
  // Set once the "you have not picked yet" nudge went out.
  reminderSentAt   DateTime?
  waRecipient      String?
  selectedOptionId String?
  publishedMediaId String?
  // Trending keywords researched before the ideas were written.
  trendKeywords    String[]      @default([])
  // Option the merchant is currently describing changes for on WhatsApp.
  editingOptionId  String?
  // IMAGE | CAPTION: what the next text message changes.
  editingMode      String?
  // Edit mode lapses after a while, so a later chat is not read as an edit.
  editingStartedAt DateTime?
  // When the picked option is due to go live (status SCHEDULED).
  scheduledFor     DateTime?
  // { IG_STORY: { ok, id?, error? }, ... }
  publishedTargets Json?
  error            Json?
  options          StoryOption[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([orgId, forDate])
  @@index([status, createdAt])
  @@index([status, scheduledFor])
}

model StoryOption {
  id             String     @id @default(uuid())
  batchId        String
  batch          StoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  position       Int
  title          String
  // Short tag shown on WhatsApp, e.g. "Trending: HD bridal base".
  label          String     @default("")
  idea           String
  caption        String?
  revision       Int        @default(0)
  imagePrompt    String
  seedKeyword    String
  imageData      Bytes?
  keywords       String[]   @default([])
  hashtags       String[]   @default([])
  finalImageData Bytes?
  // 7-second MP4 made from the image for IG_REEL, built at publish time.
  reelVideoData  Bytes?
  // AI | OWN (a photo the seller sent or uploaded; never re-lettered)
  source         String     @default("AI")
  // Catalog item the post promotes, so comments on it get that item's price.
  offeringId     String?
  createdAt      DateTime   @default(now())

  @@unique([batchId, position])
}

// Per-page overrides of the business profile, for sellers who run more than
// one page (e.g. a bridal page and a boutique page) from one workspace. Empty
// fields fall back to BusinessProfile.
model PageProfile {
  id          String       @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelId   String       @unique
  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  description String?
  audience    String?
  tone        String?
  language    String?
  // [{ q, a }], answered before the business-wide FAQs.
  faqs        Json?
  // When set, replies on this page only suggest these catalog items.
  offeringIds String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
}

// What we know about one Instagram/Facebook post: its caption (so the AI knows
// what the post says) and the seller's own note ("offer valid till Sunday").
model SocialPost {
  id        String       @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  channelId String?
  platform  String
  postId    String
  caption   String?
  mediaUrl  String?
  permalink String?
  note      String?
  // META (found on the page) | DAILY_POST (published by us)
  source    String       @default("META")
  // When the AI last matched it against the catalog; null means not yet.
  taggedAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([orgId, postId])
}

// ---------------------------------------------------------------------------
// Offerings: one catalog shape for every industry. What differs per industry
// (footwear, bridal makeup, hotel, travel, real estate, food) lives in the
// industry template in code, and in the `attributes` JSON, not in new columns.
// ---------------------------------------------------------------------------

model BusinessProfile {
  id           String       @id @default(uuid())
  orgId        String       @unique
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  industry     String       @default("APPAREL")
  description  String?
  city         String?
  serviceAreas String[]     @default([])
  hours        String?
  // { delivery, returns, advance, cancellation, payment } as short sentences.
  policies     Json?
  // [{ q, a }]
  faqs         Json?
  // Where new leads are announced (seller's own WhatsApp number, E.164 digits).
  alertPhone   String?
  autoTagPosts Boolean      @default(true)
  // Onboarding & business setup: what the seller told us about the page before automation starts.
  businessName  String?
  audience      String?
  tone          String?
  replyTone     String?
  language      String?
  replyLanguage String?
  // Automations the seller switched on: DM_REPLY, COMMENT_REPLY, WHATSAPP_REPLY
  services      String[]     @default([])
  onboardedAt   DateTime?
  activatedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Offering {
  id            String                @id @default(uuid())
  orgId         String
  org           Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  // PRODUCT | SERVICE | PACKAGE | ROOM | PROPERTY | TRIP | MENU_ITEM
  type          String                @default("PRODUCT")
  title         String
  description   String?
  // FIXED | STARTING_FROM | RANGE | PER_NIGHT | PER_PERSON | ON_REQUEST
  priceMode     String                @default("FIXED")
  priceMin      Float?
  priceMax      Float?
  currency      String                @default("INR")
  attributes    Json?
  actionUrl     String?
  imageUrl      String?
  sku           String?
  // Where it came from, so a re-sync updates instead of duplicating.
  source        String                @default("MANUAL")
  externalRef   String?
  isActive      Boolean               @default(true)
  // Bookable offerings (makeup, rooms) track dates that are already taken.
  bookable      Boolean               @default(false)
  dailyCapacity Int?
  variants      OfferingVariant[]
  components    PackageItem[]         @relation("PackageParent")
  includedIn    PackageItem[]         @relation("PackageChild")
  postLinks     PostOfferingLink[]
  leads         Lead[]
  blockedDates  OfferingBlockedDate[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([orgId, source, externalRef])
  @@index([orgId, isActive])
}

model OfferingVariant {
  id         String    @id @default(uuid())
  offeringId String
  offering   Offering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  // "Size 8 / Tan", "Deluxe · weekend", "2BHK"
  label      String
  options    Json?
  price      Float?
  stock      Int?
  validFrom  DateTime?
  validTo    DateTime?
  position   Int       @default(0)

  @@index([offeringId])
}

model PackageItem {
  id        String   @id @default(uuid())
  packageId String
  package   Offering @relation("PackageParent", fields: [packageId], references: [id], onDelete: Cascade)
  itemId    String
  item      Offering @relation("PackageChild", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([packageId, itemId])
}

model OfferingBlockedDate {
  id         String   @id @default(uuid())
  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  // YYYY-MM-DD in the org's timezone.
  date       String
  // How many of dailyCapacity are taken; null means the whole day is closed.
  booked     Int?
  note       String?

  @@unique([offeringId, date])
}

model PostOfferingLink {
  id            String       @id @default(uuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  postId        String
  platform      String
  caption       String?
  mediaUrl      String?
  permalink     String?
  offeringId    String
  offering      Offering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  // AI_SUGGESTED | SELLER_CONFIRMED | SELLER_REJECTED
  status        String       @default("AI_SUGGESTED")
  confidence    Float        @default(0)
  reason        String?
  likes         Int?
  commentsCount Int?
  // When the seller was asked on WhatsApp whether this post shows this item.
  askedAt       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([postId, offeringId])
  @@index([orgId, status])
}

model PostTagRun {
  id         String       @id @default(uuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  status     String       @default("RUNNING")
  postsSeen  Int          @default(0)
  suggested  Int          @default(0)
  error      String?
  createdAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([orgId, createdAt])
}

model Lead {
  id             String        @id @default(uuid())
  orgId          String
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  offeringId     String?
  offering       Offering?     @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  platform       String
  contactName    String?
  contactHandle  String?
  // Whatever the AI collected: date, city, guests, budget, config…
  fields         Json
  // NEW | CONTACTED | BOOKED | LOST
  status         String        @default("NEW")
  notes          String?
  alertSentAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([conversationId, offeringId])
  @@index([orgId, status, createdAt])
}
