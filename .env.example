# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/r2r?schema=public"

# Server
PORT=5002
NODE_ENV=development
PUBLIC_BASE_URL="http://localhost:5002"
FRONTEND_URL="http://localhost:3000"
# Must match Meta Valid OAuth Redirect URIs: {PUBLIC_BASE_URL}/auth/meta/callback

# Required secrets (fail-closed — do not leave these empty)
ENCRYPTION_SECRET="replace-with-32-plus-char-random-secret"
META_APP_SECRET="meta-app-secret"
META_VERIFY_TOKEN="reel2real_verify_secret"
META_APP_ID="1390089122590430"
JWT_SECRET="replace-with-long-random-jwt-secret"
# Graph
META_GRAPH_VERSION="v24.0"
# Facebook Login for Business / WhatsApp Embedded Signup configuration IDs
META_FB_LOGIN_CONFIG_ID=""
META_WA_ESU_CONFIG_ID=""
# Meta dashboard callbacks (must be HTTPS in production):
# Deauthorize: {PUBLIC_BASE_URL}/auth/facebook/deauthorize
# Data deletion: {PUBLIC_BASE_URL}/auth/facebook/data-deletion

# AI
AI_SERVICE_URL="http://127.0.0.1:8000"

# WhatsApp Cloud API (seed / production)
WHATSAPP_PHONE_NUMBER_ID="1259818730556396"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WABA_ID="1085258617761731"

# Shopify (HMAC is SHA-256 base64)
SHOPIFY_API_SECRET=""
SHOPIFY_ACCESS_TOKEN=""
SHOPIFY_SHOP_DOMAIN="your-store.myshopify.com"
SHOPIFY_WEBHOOK_SECRET=""

# Optional abandoned-cart discount codes
CART_DISCOUNT_STAGE2="SAVE5"
CART_DISCOUNT_STAGE3="SAVE10"

# Optional Meta page seed (do not commit real tokens)
# PAGE_ID_MEME_WORLD=""
# PAGE_TOKEN_MEME_WORLD=""

# Meta OAuth scopes. Leave unset to use the built-in defaults, which are all
# verified against the OAuth dialog. The Instagram permissions require the
# "Manage messaging & content on Instagram" use case (API setup with Facebook
# login) to stay enabled on the app — remove it and the dialog fails with
# "Invalid Scopes" for the whole request, not just the Instagram part.
# META_SCOPES_FACEBOOK="pages_show_list,pages_messaging,pages_manage_metadata,pages_read_engagement,pages_manage_engagement,pages_manage_posts,instagram_basic,instagram_manage_comments,instagram_manage_messages"
# META_SCOPES_INSTAGRAM="pages_show_list,pages_manage_metadata,instagram_basic,instagram_manage_comments,instagram_manage_messages,instagram_content_publishing"
# META_SCOPES_WHATSAPP="business_management,whatsapp_business_management,whatsapp_business_messaging"
